<Window x:Class="AndroidOptimize.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:AndroidOptimize.App.Converters"
        Title="安卓优化助手" Height="800" Width="1320" MinHeight="680" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:RiskToBrushConverter x:Key="RiskBrush" />
        <conv:StatusToBrushConverter x:Key="StatusBrush" />
        <conv:LogLevelToBrushConverter x:Key="LogBrush" />
        <conv:SourceToBrushConverter x:Key="SourceBrush" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.72" />
        </Style>

        <!-- 表格单元格：挡住不换行，过长自动省略，鼠标悬停显示完整内容 -->
        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,4,0" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>

        <Style x:Key="GridCellCentered" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource MaterialDesign.Brush.Primary}"
                TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                Padding="18,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="Cellphone" Width="26" Height="26" VerticalAlignment="Center" />
                    <TextBlock Text="安卓优化助手" FontSize="19" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AppVersionText}" Opacity="0.75"
                               Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
                    <TextBlock Text="{Binding ListVersionText, StringFormat=名单版本 {0}}" Opacity="0.75"
                               Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DeviceTitle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding DeviceSubtitle}" Opacity="0.75" FontSize="11" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Border Width="14" Height="14" CornerRadius="7" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFD32F2F" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="#FF00E676" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="342" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧操作区 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="14,14,8,14">
                <StackPanel>

                    <materialDesign:Card Padding="16" Margin="0,0,0,12" UniformCornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="第 1 步 · 连接手机" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding ConnectionHint}" Style="{StaticResource HintText}" Margin="0,0,0,10" />
                            <Button Content="连接手机" Command="{Binding ConnectCommand}" Height="38"
                                    Style="{StaticResource MaterialDesignRaisedButton}" />
                            <TextBlock Text="{Binding AdbStatus}" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Padding="16" Margin="0,0,0,12" UniformCornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="第 2 步 · 选择优化档位" Style="{StaticResource SectionTitle}" />
                            <RadioButton Content="只体检（不修改）" GroupName="Tier" Margin="0,4"
                                         IsChecked="{Binding IsTierScanOnly}" Style="{StaticResource MaterialDesignRadioButton}" />
                            <RadioButton Content="一般优化（推荐给家里长辈）" GroupName="Tier" Margin="0,4"
                                         IsChecked="{Binding IsTierNormal}" Style="{StaticResource MaterialDesignRadioButton}" />
                            <RadioButton Content="极客模式（逐项自己挑）" GroupName="Tier" Margin="0,4"
                                         IsChecked="{Binding IsTierGeek}" Style="{StaticResource MaterialDesignRadioButton}" />
                            <RadioButton Content="深度模式（含高风险项）" GroupName="Tier" Margin="0,4"
                                         IsChecked="{Binding IsTierDanger}" Style="{StaticResource MaterialDesignRadioButton}" />
                            <TextBlock Text="{Binding TierDescription}" Style="{StaticResource HintText}" Margin="0,10,0,0" />
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Padding="16" Margin="0,0,0,12" UniformCornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="第 3 步 · 选项" Style="{StaticResource SectionTitle}" />
                            <CheckBox Content="安全模式：卸载改为停用" IsChecked="{Binding SafetyMode}" Margin="0,4"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      ToolTip="停用比卸载更容易恢复，也不会触发系统的自动重装。建议保持勾选。" />
                            <CheckBox Content="深度扫描第三方应用安装来源" IsChecked="{Binding DeepScan}" Margin="0,4"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      ToolTip="读取每个第三方应用的安装来源与首次安装时间，用于找出被强行安装的应用。会多花 10~30 秒。" />
                            <CheckBox Content="同时优化系统动画等相关设置" IsChecked="{Binding IncludeSettings}" Margin="0,4"
                                      Style="{StaticResource MaterialDesignCheckBox}" />
                            <CheckBox Content="关闭第三方应用的传感器权限（防摇一摇广告）" IsChecked="{Binding SensorPolicyEnabled}"
                                      Margin="0,4" Style="{StaticResource MaterialDesignCheckBox}"
                                      ToolTip="摇一摇广告靠加速度传感器触发。微信、QQ、地图导航与运动健康类应用会自动排除，不受影响。" />

                            <Separator Margin="0,10" />

                            <TextBlock Text="动画速度" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox SelectedValue="{Binding AnimationScale}" SelectedValuePath="Tag" Width="200" HorizontalAlignment="Left">
                                <ComboBoxItem Content="0.5x（最快）" Tag="0.5" />
                                <ComboBoxItem Content="0.75x（推荐）" Tag="0.75" />
                                <ComboBoxItem Content="1x（系统默认）" Tag="1" />
                            </ComboBox>

                            <Separator Margin="0,10" />

                            <CheckBox Content="允许操作微信等受保护应用" IsChecked="{Binding AllowGuarded}" Margin="0,4"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      ToolTip="默认关闭。开启后微信、QQ 等应用才会出现在候选列表里，且仍然需要你手动勾选。" />
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Padding="16" Margin="0,0,0,12" UniformCornerRadius="8">
                        <Expander Header="AI 识别未知应用（可选）" FontWeight="SemiBold">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="{Binding AiStatusText}" Style="{StaticResource HintText}" Margin="0,0,0,10" />
                                <CheckBox Content="启用 AI 识别" IsChecked="{Binding EnableAi}" Margin="0,4"
                                          Style="{StaticResource MaterialDesignCheckBox}" />
                                <CheckBox IsChecked="{Binding ConsentToSendPackageNames}" Margin="0,4"
                                          Style="{StaticResource MaterialDesignCheckBox}">
                                    <TextBlock TextWrapping="Wrap" Text="我同意把「名单里查不到的应用包名」发送到 DeepSeek 进行识别" />
                                </CheckBox>
                                <TextBlock Text="{Binding AiKeyStatusText}" Style="{StaticResource HintText}" Margin="0,8,0,4" />
                                <PasswordBox x:Name="ApiKeyBox" materialDesign:HintAssist.Hint="粘贴新的 API Key" Margin="0,0,0,8"
                                             PasswordChanged="ApiKeyBox_OnPasswordChanged" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="保存 Key" Command="{Binding SaveAiSettingsCommand}" Margin="0,0,8,0"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                                    <Button Content="清除 Key" Command="{Binding ClearAiKeyCommand}" Margin="0,0,8,0"
                                            Style="{StaticResource MaterialDesignFlatButton}" />
                                    <Button Content="清空缓存" Command="{Binding ClearAiCacheCommand}"
                                            Style="{StaticResource MaterialDesignFlatButton}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                           Text="不填 Key 也能用，只是名单外的应用不会被自动识别。API Key 使用 Windows 凭据加密后只保存在本机。" />
                            </StackPanel>
                        </Expander>
                    </materialDesign:Card>

                    <materialDesign:Card Padding="16" Margin="0,0,0,12" UniformCornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="数据与报告" Style="{StaticResource SectionTitle}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="导出体检报告" Command="{Binding ExportScanReportCommand}" Margin="0,0,8,0"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                                <Button Content="导出执行报告" Command="{Binding ExportExecutionReportCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="打开数据目录" Command="{Binding OpenUserFolderCommand}" Margin="0,0,8,0"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                <Button Content="保存日志" Command="{Binding SaveLogCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                            </StackPanel>
                            <TextBlock Text="{Binding AboutText}" Style="{StaticResource HintText}" Margin="0,10,0,0" />
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- 主操作固定在这里，不随左侧滚动条跑掉 -->
            <Border Grid.Row="1" Padding="14,10,8,14"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MaterialDesignDivider}">
                <StackPanel>
                    <TextBlock Text="第 4 步 · 执行" Style="{StaticResource SectionTitle}" />
                    <Button Content="开始扫描手机" Command="{Binding ScanCommand}" Height="42" Margin="0,0,0,8"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                    <Button Content="执行优化" Command="{Binding ExecuteCommand}" Height="42"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                    <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource HintText}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            </Grid>

            <!-- 右侧内容区 -->
            <TabControl Grid.Column="1" x:Name="MainTabs" Margin="6,12,14,12" Background="Transparent">

                <!-- 体检 -->
                <TabItem Header="手机体检">
                    <DockPanel Margin="0,10,0,0">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Width="240" Text="{Binding ScanFilter, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="搜索包名或应用名" />
                            <CheckBox Grid.Column="1" Content="显示全部系统应用" Margin="16,0,0,0" VerticalAlignment="Center"
                                      IsChecked="{Binding ShowSystemApps}" Style="{StaticResource MaterialDesignCheckBox}" />
                            <TextBlock Grid.Column="2" Text="{Binding ScanSummary}" VerticalAlignment="Center"
                                       Margin="16,0,0,0" TextWrapping="Wrap" Opacity="0.75" />
                        </Grid>
                        <DataGrid ItemsSource="{Binding ScanRowsView}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Style="{StaticResource MaterialDesignDataGrid}" FontSize="12"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <!-- 表格放不下的安装来源与首次安装时间，鼠标悬停时看这里 -->
                                    <Setter Property="ToolTip" Value="{Binding RowTooltip}" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="包名" Binding="{Binding PackageName, Mode=OneWay}" Width="24*"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="名称" Binding="{Binding DisplayName, Mode=OneWay}" Width="13*"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="类型·状态" Binding="{Binding TypeStateText, Mode=OneWay}" Width="14*"
                                                    ElementStyle="{StaticResource GridCellCentered}" />
                                <DataGridTextColumn Header="名单判定" Binding="{Binding ListStateText, Mode=OneWay}" Width="15*"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="安装来源" Binding="{Binding InstallerText, Mode=OneWay}" Width="20*"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="说明" Binding="{Binding NoteText, Mode=OneWay}" Width="26*"
                                                    ElementStyle="{StaticResource GridCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- 优化计划 -->
                <TabItem Header="优化计划">
                    <DockPanel Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SkippedSummary}" TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="全选推荐项" Command="{Binding SelectRecommendedCommand}" Margin="0,0,8,0"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                                <Button Content="全选" Command="{Binding SelectAllCommand}" Margin="0,0,8,0"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                <Button Content="全不选" Command="{Binding SelectNoneCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                            </StackPanel>
                            <Border Margin="0,12,0,0" Padding="12" CornerRadius="8"
                                    Background="#FFF3E0" BorderBrush="#FFE0B2" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="懒人模式：只保留常用应用" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.85" Margin="0,0,0,8"
                                               Text="不做任何猜测：除「必须保留清单」里的应用外，其余全部勾选。适合给长辈收拾手机——不用一个个挑，也不会因为认不出某个包名而漏掉。" />
                                    <Button Content="一键勾选（白名单之外全部处理）"
                                            Command="{Binding ApplyLazyModeCommand}" HorizontalAlignment="Left"
                                            ToolTipService.ShowDuration="60000"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            ToolTip="勾选「必须保留清单」之外的全部项目。保留清单写在 data/packages.json 的 lazyMode.keep 里，默认含微信、QQ、抖音、快手、地图导航、出行、办公、医院健康；保护名单（反诈、支付、输入法、电话短信）自动保留。执行前请扫一眼列表。" />
                                    <Button Content="只处理「名单外」的应用（更保守）"
                                            Command="{Binding SelectUnknownCommand}" Margin="0,8,0,0"
                                            HorizontalAlignment="Left" ToolTipService.ShowDuration="30000"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            ToolTip="只勾选名单里查不到的第三方应用，名单里已有的处理项保持原样。" />
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.72" Margin="0,8,0,0"
                                               Text="保留清单可以在 data/packages.json 的 lazyMode.keep 里自己增删；写错了在「回滚」页一键还原即可。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding PlanItems}" AutoGenerateColumns="False"
                                  Style="{StaticResource MaterialDesignDataGrid}" FontSize="12"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="选择" Width="46">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsSelectable}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="名称" Binding="{Binding DisplayName, Mode=OneWay}" Width="18*"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="包名 / 设置项" Binding="{Binding Target, Mode=OneWay}" Width="22*"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="动作" Binding="{Binding ActionText, Mode=OneWay}" Width="10*"
                                                    ElementStyle="{StaticResource GridCellCentered}" />
                                <DataGridTemplateColumn Header="风险" Width="9*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RiskText}" FontWeight="SemiBold"
                                                       Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}"
                                                       HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="来源" Width="10*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SourceText}"
                                                       Foreground="{Binding SourceText, Converter={StaticResource SourceBrush}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="参数" Width="13*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding SelectedChoice, UpdateSourceTrigger=PropertyChanged}"
                                                      Visibility="{Binding HasChoices, Converter={StaticResource BoolToVis}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="说明" Binding="{Binding DetailText, Mode=OneWay}" Width="34*"
                                                    ElementStyle="{StaticResource GridCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- 执行结果 -->
                <TabItem Header="执行结果">
                    <DockPanel Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                        <materialDesign:Card DockPanel.Dock="Bottom" Padding="14" Margin="0,12,0,0" UniformCornerRadius="8"
                                             Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="优化完成之后" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding AftercareText}" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                        </materialDesign:Card>
                        <DataGrid ItemsSource="{Binding ResultRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Style="{StaticResource MaterialDesignDataGrid}" FontSize="12"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="项目" Binding="{Binding DisplayName, Mode=OneWay}" Width="18*"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="包名 / 设置项" Binding="{Binding Target, Mode=OneWay}" Width="24*"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="动作" Binding="{Binding ActionText, Mode=OneWay}" Width="10*"
                                                    ElementStyle="{StaticResource GridCellCentered}" />
                                <DataGridTemplateColumn Header="结果" Width="13*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="回读校验" Binding="{Binding VerifyText, Mode=OneWay}" Width="11*"
                                                    ElementStyle="{StaticResource GridCellCentered}" />
                                <DataGridTextColumn Header="说明" Binding="{Binding Message, Mode=OneWay}" Width="34*"
                                                    ElementStyle="{StaticResource GridCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- 回滚 -->
                <TabItem Header="回滚">
                    <DockPanel Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="每次执行优化前都会自动保存快照。选择一条记录即可把手机还原到当时的状态。" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,6,0,0"
                                       Text="还原会把停用的应用重新启用、把卸载的应用重新装回、把改过的设置写回原值。还原后建议重启手机。" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="一键还原选中的快照" Command="{Binding RollbackCommand}" Margin="0,0,8,0"
                                        Style="{StaticResource MaterialDesignRaisedButton}" />
                                <Button Content="刷新列表" Command="{Binding OpenSnapshotFolderCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                            </StackPanel>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,6">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.7" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <!-- 日志 -->
                <TabItem Header="日志">
                    <DockPanel Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="打开日志目录" Command="{Binding SaveLogCommand}" Margin="0,0,8,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                            <TextBlock Text="遇到问题请把这个目录里的日志文件发给开发者。" VerticalAlignment="Center" Opacity="0.7" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding LogEntries}" FontFamily="Consolas, Microsoft YaHei UI"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" TextWrapping="NoWrap" FontSize="12"
                                               Foreground="{Binding Level, Converter={StaticResource LogBrush}}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="{DynamicResource MaterialDesignCardBackground}" Padding="16,10"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MaterialDesignDivider}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                    <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Height="4" Margin="0,8,0,0"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BusyText}" Margin="0,0,12,0" VerticalAlignment="Center" Opacity="0.75"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <Button Content="取消" Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
