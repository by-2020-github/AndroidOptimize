<Window x:Class="AndroidOptimize.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:AndroidOptimize.App.Converters"
        Title="安卓优化助手" Height="800" Width="1320" MinHeight="680" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:RiskToBrushConverter x:Key="RiskBrush" />
        <conv:PermissionToBrushConverter x:Key="PermissionBrush" />
        <conv:RestorabilityToBrushConverter x:Key="RestoreBrush" />
        <conv:StatusToBrushConverter x:Key="StatusBrush" />
        <conv:LogLevelToBrushConverter x:Key="LogBrush" />
        <conv:SourceToBrushConverter x:Key="SourceBrush" />
        <conv:AdviceToBrushConverter x:Key="AdviceBrush" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.72" />
        </Style>

        <!-- 表格单元格：挡住不换行，过长自动省略，鼠标悬停显示完整内容 -->
        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,4,0" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>

        <Style x:Key="GridCellCentered" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0" />
        </Style>

        <!-- 筛选下拉前面的小标签。Material 的浮动提示在表格上方会被挤掉，直接写死标签更清楚 -->
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="10,0,6,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource MaterialDesign.Brush.Primary}"
                TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                Padding="18,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="Cellphone" Width="26" Height="26" VerticalAlignment="Center" />
                    <TextBlock Text="安卓优化助手" FontSize="19" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AppVersionText}" Opacity="0.75"
                               Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
                    <TextBlock Text="{Binding ListVersionText, StringFormat=名单版本 {0}}" Opacity="0.75"
                               Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DeviceTitle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding DeviceSubtitle}" Opacity="0.75" FontSize="11" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Border Width="14" Height="14" CornerRadius="7" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFD32F2F" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="#FF00E676" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="342" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧操作区 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="14,14,8,14">
                <StackPanel>

                    <materialDesign:Card Padding="16" Margin="0,0,0,12" UniformCornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="第 1 步 · 连接手机" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding ConnectionHint}" Style="{StaticResource HintText}" Margin="0,0,0,10" />
                            <Button Content="连接手机" Command="{Binding ConnectCommand}" Height="38"
                                    Style="{StaticResource MaterialDesignRaisedButton}" />
                            <TextBlock Text="{Binding AdbStatus}" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Padding="16" Margin="0,0,0,12" UniformCornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="第 2 步 · 选择优化档位" Style="{StaticResource SectionTitle}" />
                            <RadioButton Content="只体检（不修改）" GroupName="Tier" Margin="0,4"
                                         IsChecked="{Binding IsTierScanOnly}" Style="{StaticResource MaterialDesignRadioButton}" />
                            <RadioButton Content="一般优化（推荐给家里长辈）" GroupName="Tier" Margin="0,4"
                                         IsChecked="{Binding IsTierNormal}" Style="{StaticResource MaterialDesignRadioButton}" />
                            <RadioButton Content="极客模式（逐项自己挑）" GroupName="Tier" Margin="0,4"
                                         IsChecked="{Binding IsTierGeek}" Style="{StaticResource MaterialDesignRadioButton}" />
                            <RadioButton Content="深度模式（含高风险项）" GroupName="Tier" Margin="0,4"
                                         IsChecked="{Binding IsTierDanger}" Style="{StaticResource MaterialDesignRadioButton}" />
                            <TextBlock Text="{Binding TierDescription}" Style="{StaticResource HintText}" Margin="0,10,0,0" />
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Padding="16" Margin="0,0,0,12" UniformCornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="第 3 步 · 选项" Style="{StaticResource SectionTitle}" />
                            <CheckBox Content="安全模式：卸载改为停用" IsChecked="{Binding SafetyMode}" Margin="0,4"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      ToolTip="停用比卸载更容易恢复，也不会触发系统的自动重装。建议保持勾选。" />
                            <CheckBox Content="深度扫描：读取安装来源与权限列表" IsChecked="{Binding DeepScan}" Margin="0,4"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      ToolTipService.ShowDuration="30000"
                                      ToolTip="读取每个第三方应用的安装来源、首次安装时间，以及它申请的权限列表。前者用来找出被强行安装的应用，后者用来筛出申请了悬浮窗、安装应用这类高危权限的应用。会多花 10~30 秒。" />
                            <CheckBox Content="强制重新读取权限（忽略缓存）" IsChecked="{Binding ForceDetailRefresh}" Margin="0,4"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      ToolTipService.ShowDuration="30000"
                                      ToolTip="默认会用上次扫描缓存下来的权限与安装来源，重复扫描只要 1~2 秒（这些信息只随应用更新变化，缓存是安全的）。&#10;&#10;只在需要「手机上此刻的真实状态」时勾上，例如刚在手机里改过权限、刚装完应用。勾上后扫描会慢一些（每个应用都要跑一次 dumpsys）。" />
                            <CheckBox Content="卸载前备份安装包（强烈建议）" IsChecked="{Binding BackupApksBeforeUninstall}" Margin="0,4"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      ToolTipService.ShowDuration="60000"
                                      ToolTip="**关掉它就可能永远装不回来。**&#10;&#10;商店安装的应用（安装包在 /data/app）被卸载时，安装包会被系统一起删掉——之后连本程序也救不回来。勾上这一项，程序会在卸载前把安装包备份到电脑（%LOCALAPPDATA%\AndroidOptimize\devices\序列号\apk-backup\），回滚时用备份装回去。&#10;&#10;系统预装应用不受影响（系统分区上还有副本，随时能装回来）。" />
                            <CheckBox Content="同时优化系统动画等相关设置" IsChecked="{Binding IncludeSettings}" Margin="0,4"
                                      Style="{StaticResource MaterialDesignCheckBox}" />
                            <CheckBox Content="关闭第三方应用的传感器权限（防摇一摇广告）" IsChecked="{Binding SensorPolicyEnabled}"
                                      Margin="0,4" Style="{StaticResource MaterialDesignCheckBox}"
                                      ToolTip="摇一摇广告靠加速度传感器触发。微信、QQ、地图导航与运动健康类应用会自动排除，不受影响。" />

                            <Separator Margin="0,10" />

                            <TextBlock Text="动画速度" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox SelectedValue="{Binding AnimationScale}" SelectedValuePath="Tag" Width="200" HorizontalAlignment="Left">
                                <ComboBoxItem Content="0.5x（最快）" Tag="0.5" />
                                <ComboBoxItem Content="0.75x（推荐）" Tag="0.75" />
                                <ComboBoxItem Content="1x（系统默认）" Tag="1" />
                            </ComboBox>

                            <Separator Margin="0,10" />

                            <CheckBox Content="允许操作微信等受保护应用" IsChecked="{Binding AllowGuarded}" Margin="0,4"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      ToolTip="默认关闭。开启后微信、QQ 等应用才会出现在候选列表里，且仍然需要你手动勾选。" />
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Padding="16" Margin="0,0,0,12" UniformCornerRadius="8">
                        <Expander Header="AI 识别未知应用（可选）" FontWeight="SemiBold" IsExpanded="True">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="{Binding AiStatusText}" Style="{StaticResource HintText}" Margin="0,0,0,10" />
                                <CheckBox Content="启用 AI 识别" IsChecked="{Binding EnableAi}" Margin="0,4"
                                          Style="{StaticResource MaterialDesignCheckBox}" />
                                <CheckBox IsChecked="{Binding ConsentToSendPackageNames}" Margin="0,4"
                                          Style="{StaticResource MaterialDesignCheckBox}">
                                    <TextBlock TextWrapping="Wrap" Text="我同意把「名单里查不到的应用包名」发送到 DeepSeek 进行识别" />
                                </CheckBox>
                                <TextBlock Text="{Binding AiKeyStatusText}" Style="{StaticResource HintText}" Margin="0,8,0,4" />
                                <PasswordBox x:Name="ApiKeyBox" materialDesign:HintAssist.Hint="粘贴新的 API Key" Margin="0,0,0,8"
                                             PasswordChanged="ApiKeyBox_OnPasswordChanged" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="保存 Key" Command="{Binding SaveAiSettingsCommand}" Margin="0,0,8,0"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                                    <Button Content="清除 Key" Command="{Binding ClearAiKeyCommand}" Margin="0,0,8,0"
                                            Style="{StaticResource MaterialDesignFlatButton}" />
                                    <Button Content="清空缓存" Command="{Binding ClearAiCacheCommand}"
                                            Style="{StaticResource MaterialDesignFlatButton}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                           Text="不填 Key 也能用，只是名单外的应用不会被自动识别。API Key 使用 Windows 凭据加密后只保存在本机。" />
                            </StackPanel>
                        </Expander>
                    </materialDesign:Card>

                    <materialDesign:Card Padding="16" Margin="0,0,0,12" UniformCornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="数据与报告" Style="{StaticResource SectionTitle}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="导出体检报告" Command="{Binding ExportScanReportCommand}" Margin="0,0,8,0"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                                <Button Content="导出执行报告" Command="{Binding ExportExecutionReportCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="打开数据目录" Command="{Binding OpenUserFolderCommand}" Margin="0,0,8,0"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                <Button Content="保存日志" Command="{Binding SaveLogCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="这台手机的数据" Command="{Binding OpenDeviceFolderCommand}" Margin="0,0,8,0"
                                        ToolTipService.ShowDuration="30000"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        ToolTip="每台手机的数据都按序列号分开放：devices\序列号\ 下面是这台手机的设备信息、扫描记录、快照与报告。" />
                                <Button Content="导出数据统计" Command="{Binding ExportStatisticsCommand}"
                                        ToolTipService.ShowDuration="30000"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        ToolTip="把所有手机的档案汇总成一份统计：机型与系统版本、名单外的应用、权限命中排行、没收录但常见的权限。用来改进名单和程序。**不含序列号等个人信息**。" />
                            </StackPanel>
                            <TextBlock Text="{Binding DeviceDataPath}" Style="{StaticResource HintText}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding AboutText}" Style="{StaticResource HintText}" Margin="0,10,0,0" />
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- 主操作固定在这里，不随左侧滚动条跑掉 -->
            <Border Grid.Row="1" Padding="14,10,8,14"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MaterialDesignDivider}">
                <StackPanel>
                    <TextBlock Text="第 4 步 · 执行" Style="{StaticResource SectionTitle}" />
                    <Button Content="{Binding ScanButtonText}" Command="{Binding ScanCommand}" Height="42" Margin="0,0,0,8"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                    <Button Content="执行优化" Command="{Binding ExecuteCommand}" Height="42"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                    <Button Content="识别未知应用（AI）" Command="{Binding ClassifyNowCommand}" Height="38" Margin="0,8,0,0"
                            ToolTipService.ShowDuration="30000"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            ToolTip="对当前扫描结果里的未知应用联网识别，不需要重新扫描。需要先在左侧「AI 识别未知应用」里填好 Key 并勾选同意；识别结果会出现在「优化计划」页，默认不勾选。" />
                    <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource HintText}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            </Grid>

            <!-- 右侧内容区 -->
            <TabControl Grid.Column="1" x:Name="MainTabs" Margin="6,12,14,12" Background="Transparent">

                <!-- 体检 -->
                <TabItem Header="手机体检">
                    <DockPanel Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <WrapPanel Orientation="Horizontal">
                                <TextBox Width="200" Text="{Binding ScanFilter, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="搜索应用名或包名" />
                                <TextBlock Text="类型" Style="{StaticResource FilterLabel}" />
                                <ComboBox Width="100" VerticalAlignment="Center" ItemsSource="{Binding TypeFilterOptions}"
                                          SelectedItem="{Binding ScanTypeFilter}" />
                                <TextBlock Text="建议" Style="{StaticResource FilterLabel}" />
                                <ComboBox Width="120" VerticalAlignment="Center" ItemsSource="{Binding AdviceFilterOptions}"
                                          SelectedItem="{Binding ScanAdviceFilter}" />
                                <TextBlock Text="权限" Style="{StaticResource FilterLabel}" />
                                <ComboBox Width="145" VerticalAlignment="Center" ItemsSource="{Binding PermissionFilterOptions}"
                                          SelectedItem="{Binding ScanPermissionFilter}"
                                          ToolTipService.ShowDuration="30000"
                                          ToolTip="按申请的权限筛出可疑应用。选「含高危权限」= 申请了悬浮窗、安装应用、读取所有应用、无障碍、读取短信里的任意一条。权限在勾选「深度扫描」时读取。" />
                                <TextBlock Text="{Binding ScanFilterSummary}" VerticalAlignment="Center"
                                           Margin="14,0,0,0" Opacity="0.7" />
                            </WrapPanel>
                            <TextBlock Text="{Binding ScanSummary}" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.75" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding ScanRowsView}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Style="{StaticResource MaterialDesignDataGrid}" FontSize="12"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <!-- 表格放不下的安装来源与首次安装时间，鼠标悬停时看这里 -->
                                    <Setter Property="ToolTip" Value="{Binding RowTooltip}" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="应用名" Binding="{Binding DisplayName, Mode=OneWay}" Width="15*"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="包名" Binding="{Binding PackageName, Mode=OneWay}" Width="17*"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="类型·状态" Binding="{Binding TypeStateText, Mode=OneWay}" Width="10*"
                                                    ElementStyle="{StaticResource GridCellCentered}" />
                                <DataGridTextColumn Header="建议" Binding="{Binding AdviceText, Mode=OneWay}" Width="13*"
                                                    ElementStyle="{StaticResource GridCellCentered}" />
                                <DataGridTemplateColumn Header="权限" Width="13*" SortMemberPath="PermissionSortRank">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PermissionText}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding PermissionProfile, Converter={StaticResource PermissionBrush}}"
                                                       ToolTipService.ShowDuration="60000"
                                                       ToolTip="{Binding PermissionProfile.Tooltip}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="安装来源" Binding="{Binding InstallerText, Mode=OneWay}" Width="12*"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="作用 / 说明" Binding="{Binding NoteText, Mode=OneWay}" Width="26*"
                                                    ElementStyle="{StaticResource GridCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- 优化计划 -->
                <TabItem Header="优化计划">
                    <DockPanel Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SkippedSummary}" TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="全选推荐项" Command="{Binding SelectRecommendedCommand}" Margin="0,0,8,0"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                                <Button Content="全选" Command="{Binding SelectAllCommand}" Margin="0,0,8,0"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                <Button Content="全不选" Command="{Binding SelectNoneCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                            </StackPanel>
                            <!-- 勾选之后直接动手：弹窗确认一次，执行完给结果 -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="对勾选的应用立即执行：" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
                                <Button x:Name="SetSelectedDisableButton" Content="停用" Command="{Binding SetSelectedDisableCommand}" Margin="8,0,8,0"
                                        ToolTipService.ShowDuration="30000" Height="30" Padding="12,0"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        ToolTip="立即停用已勾选的应用：会先弹窗列出清单让你确认，执行完给出结果。停用后应用不能运行、图标消失，随时可在「回滚」页一键还原。" />
                                <Button x:Name="SetSelectedUninstallButton" Content="卸载" Command="{Binding SetSelectedUninstallCommand}"
                                        ToolTipService.ShowDuration="30000" Height="30" Padding="12,0"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        ToolTip="立即卸载已勾选的应用：会先弹窗列出清单让你确认，执行完给出结果。卸载保留应用数据，也能在「回滚」页装回来；系统不允许卸载的会自动降级为停用。" />
                            </StackPanel>
                            <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBox Width="160" Text="{Binding PlanSearch, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="搜索应用名或包名" />
                                <TextBlock Text="类型" Style="{StaticResource FilterLabel}" />
                                <ComboBox Width="90" VerticalAlignment="Center" ItemsSource="{Binding TypeFilterOptions}"
                                          SelectedItem="{Binding PlanTypeFilter}" />
                                <TextBlock Text="建议" Style="{StaticResource FilterLabel}" />
                                <ComboBox Width="110" VerticalAlignment="Center" ItemsSource="{Binding AdviceFilterOptions}"
                                          SelectedItem="{Binding PlanAdviceFilter}" />
                                <TextBlock Text="风险" Style="{StaticResource FilterLabel}" />
                                <ComboBox Width="75" VerticalAlignment="Center" ItemsSource="{Binding RiskFilterOptions}"
                                          SelectedItem="{Binding PlanRiskFilter}" />
                                <TextBlock Text="权限" Style="{StaticResource FilterLabel}" />
                                <ComboBox Width="145" VerticalAlignment="Center" ItemsSource="{Binding PermissionFilterOptions}"
                                          SelectedItem="{Binding PlanPermissionFilter}"
                                          ToolTipService.ShowDuration="30000"
                                          ToolTip="按申请的权限筛。选「含高危权限」可以一次挑出申请了悬浮窗、安装应用、读取所有应用、无障碍、读取短信的应用。" />
                                <TextBlock Text="{Binding PlanFilterSummary}" VerticalAlignment="Center"
                                           Margin="14,0,0,0" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                            </WrapPanel>
                            <Border Margin="0,12,0,0" Padding="12" CornerRadius="8"
                                    Background="#FFF3E0" BorderBrush="#FFE0B2" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="名单里查不到的应用" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.85" Margin="0,0,0,8"
                                               Text="有离线名册资料的应用会按社区的清理结论各自标注（名册说「建议清理」的已经默认勾上）。完全没有资料的只剩第三方应用，需要你自己看一眼——它们默认不勾。" />
                                    <Button Content="选中全部「名单外」的应用"
                                            Command="{Binding SelectUnknownCommand}" HorizontalAlignment="Left"
                                            ToolTipService.ShowDuration="60000"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            ToolTip="把名单和名册里都查不到的第三方应用一次勾上。它们会被停用而不是卸载，随时可在「回滚」页还原。执行前请扫一眼列表，把医院挂号、社区服务这类要紧的应用取消勾选。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding PlanItems}" AutoGenerateColumns="False"
                                  Style="{StaticResource MaterialDesignDataGrid}" FontSize="12"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="ToolTip" Value="{Binding RowTooltip}" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="选择" Width="88" SortMemberPath="IsSelected">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsSelectable}" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="应用名" Binding="{Binding DisplayName, Mode=OneWay}" Width="15*"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="包名 / 项目" Binding="{Binding Target, Mode=OneWay}" Width="16*"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="类型" Binding="{Binding TypeText, Mode=OneWay}" Width="9*"
                                                    ElementStyle="{StaticResource GridCellCentered}" />
                                <!-- 动作：可以直接在这行选「停用 / 卸载」，设置项与后台限制仍是文字 -->
                                <DataGridTemplateColumn Header="动作" Width="11*" SortMemberPath="ActionText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <ComboBox ItemsSource="{Binding ActionOptions}" DisplayMemberPath="Label"
                                                          SelectedValuePath="Value" Margin="2,1"
                                                          SelectedValue="{Binding SelectedAction, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTipService.ShowDuration="30000"
                                                          ToolTip="自己选这一项是停用还是卸载。安全模式不会降级你手动选的动作。"
                                                          Visibility="{Binding CanChooseAction, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding ActionText}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" FontWeight="SemiBold"
                                                           Visibility="{Binding CanChooseAction, Converter={StaticResource InverseBoolToVis}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="建议" Width="12*" SortMemberPath="AdviceGroup">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AdviceText}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Foreground="{Binding AdviceGroup, Converter={StaticResource AdviceBrush}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="风险" Width="8*" SortMemberPath="Risk">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RiskText}" FontWeight="SemiBold"
                                                       Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}"
                                                       HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="权限" Width="18*" SortMemberPath="PermissionSortRank">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PermissionText}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding PermissionProfile, Converter={StaticResource PermissionBrush}}"
                                                       ToolTipService.ShowDuration="60000"
                                                       ToolTip="{Binding PermissionProfile.Tooltip}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- 设置项的参数选择直接放在说明列里，省一列宽度 -->
                                <DataGridTemplateColumn Header="作用 / 说明" Width="18*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
                                                          SelectedValuePath="Value" Margin="4,2"
                                                          SelectedValue="{Binding SelectedChoice, UpdateSourceTrigger=PropertyChanged}"
                                                          Visibility="{Binding HasChoices, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding DetailText}" Margin="8,0,4,0"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DetailText}"
                                                           Visibility="{Binding HasChoices, Converter={StaticResource InverseBoolToVis}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- 执行结果 -->
                <TabItem Header="执行结果">
                    <DockPanel Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                        <materialDesign:Card DockPanel.Dock="Bottom" Padding="14" Margin="0,12,0,0" UniformCornerRadius="8"
                                             Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="优化完成之后" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding AftercareText}" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                        </materialDesign:Card>
                        <DataGrid ItemsSource="{Binding ResultRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Style="{StaticResource MaterialDesignDataGrid}" FontSize="12"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="项目" Binding="{Binding DisplayName, Mode=OneWay}" Width="18*"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="包名 / 设置项" Binding="{Binding Target, Mode=OneWay}" Width="24*"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="动作" Binding="{Binding ActionText, Mode=OneWay}" Width="10*"
                                                    ElementStyle="{StaticResource GridCellCentered}" />
                                <DataGridTemplateColumn Header="结果" Width="13*" SortMemberPath="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="回读校验" Binding="{Binding VerifyText, Mode=OneWay}" Width="11*"
                                                    ElementStyle="{StaticResource GridCellCentered}" />
                                <DataGridTextColumn Header="说明" Binding="{Binding Message, Mode=OneWay}" Width="34*"
                                                    ElementStyle="{StaticResource GridCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- 回滚 -->
                <TabItem Header="回滚">
                    <DockPanel Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="每次执行优化前都会自动保存快照。选择一条记录即可把手机还原到当时的状态。" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,6,0,0"
                                       Text="还原会把停用的应用重新启用、把卸载的应用重新装回（用电脑上的安装包备份）、把改过的设置写回原值。还原后建议重启手机。" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,6,0,0"
                                       Text="双击下面任意一条记录，可以看到那次一共改了什么、每一项还能不能恢复。" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="一键还原选中的快照" Command="{Binding RollbackCommand}" Margin="0,0,8,0"
                                        Style="{StaticResource MaterialDesignRaisedButton}" />
                                <Button Content="查看这条改了什么" Command="{Binding ShowRollbackDetailCommand}" Margin="0,0,8,0"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                                <Button Content="刷新列表" Command="{Binding OpenSnapshotFolderCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                            </StackPanel>
                        </StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" MinHeight="120" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3*" MinHeight="0" />
                            </Grid.RowDefinitions>

                            <ListBox Grid.Row="0" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="Snapshots_OnMouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,6">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.7" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 双击后在下面列出这次改了什么，以及每一项还能不能恢复 -->
                            <TextBlock Grid.Row="1" Text="{Binding RollbackDetailTitle}" TextWrapping="Wrap"
                                       FontWeight="SemiBold" Margin="0,10,0,6"
                                       Visibility="{Binding HasRollbackDetail, Converter={StaticResource BoolToVis}}" />

                            <DataGrid Grid.Row="2" ItemsSource="{Binding RollbackItems}" AutoGenerateColumns="False" IsReadOnly="True"
                                      Style="{StaticResource MaterialDesignDataGrid}" FontSize="12"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                                      Visibility="{Binding HasRollbackDetail, Converter={StaticResource BoolToVis}}">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="ToolTip" Value="{Binding RowTooltip}" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="应用名" Binding="{Binding DisplayName, Mode=OneWay}" Width="18*"
                                                        ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="包名" Binding="{Binding Target, Mode=OneWay}" Width="24*"
                                                        ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="当时的动作" Binding="{Binding ActionText, Mode=OneWay}" Width="11*"
                                                        ElementStyle="{StaticResource GridCellCentered}" />
                                    <DataGridTextColumn Header="原状态" Binding="{Binding StateText, Mode=OneWay}" Width="10*"
                                                        ElementStyle="{StaticResource GridCellCentered}" />
                                    <DataGridTemplateColumn Header="能不能恢复" Width="37*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding RestoreText}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Margin="8,0,4,0"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding State, Converter={StaticResource RestoreBrush}}"
                                                           ToolTip="{Binding RestoreText}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <!-- 日志 -->
                <TabItem Header="日志">
                    <DockPanel Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="打开日志目录" Command="{Binding SaveLogCommand}" Margin="0,0,8,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                            <TextBlock Text="遇到问题请把这个目录里的日志文件发给开发者。" VerticalAlignment="Center" Opacity="0.7" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding LogEntries}" FontFamily="Consolas, Microsoft YaHei UI"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" TextWrapping="NoWrap" FontSize="12"
                                               Foreground="{Binding Level, Converter={StaticResource LogBrush}}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="{DynamicResource MaterialDesignCardBackground}" Padding="16,10"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MaterialDesignDivider}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                    <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Height="4" Margin="0,8,0,0"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BusyText}" Margin="0,0,12,0" VerticalAlignment="Center" Opacity="0.75"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <Button Content="取消" Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
