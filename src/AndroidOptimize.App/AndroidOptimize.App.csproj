<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>AndroidOptimize.App</RootNamespace>
    <AssemblyName>AndroidOptimize</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <Version>0.1.0</Version>
    <Product>安卓优化助手</Product>
    <AssemblyTitle>安卓优化助手</AssemblyTitle>
    <Description>给长辈收拾安卓手机的小工具：免 Root、免安装、一键优化、随时可退。</Description>
    <!-- 不把 git 提交号写进版本号：历史会被重写，写死的 SHA 会变成错的。 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AndroidOptimize.Core\AndroidOptimize.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\data\packages.json" Link="data\packages.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\data\protected.json" Link="data\protected.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
