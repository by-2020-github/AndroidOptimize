<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    固定包源，避免依赖开发机上的全局 NuGet 配置。
    若需要国内加速，可取消下方 <add key="nuget.org.cn" ... /> 的注释。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- <add key="nuget.org.cn" value="https://nuget.cdn.azure.cn/v3/index.json" protocolVersion="3" /> -->
  </packageSources>
</configuration>
